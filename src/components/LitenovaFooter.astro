---
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
---

<footer class="sl-flex litenova-page-footer">
  <div class="meta sl-flex">
    <LastUpdated />
  </div>
  <Pagination />
  <div class="litenova-site-footer">
    <p>Engineering Standards — Litenova Solutions</p>
    <p>© 2026 Litenova Solutions. MIT License.</p>
  </div>
</footer>

<style>
  @layer starlight.core {
    footer.litenova-page-footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .litenova-site-footer {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--sl-color-hairline);
      text-align: center;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
    }
    .litenova-site-footer p {
      margin: 0.25rem 0;
    }
  }
</style>
