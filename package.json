{
  "name": "litenova-solutions-public-site",
  "description": "Public website and Engineering Standards documentation for Litenova Solutions, built with Next.js and Fumadocs.",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://www.litenova.solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Litenova-Solutions/Litenova.Solutions-Public-Site.git"
  },
  "bugs": {
    "url": "https://github.com/Litenova-Solutions/Litenova.Solutions-Public-Site/issues"
  },
  "author": "Litenova Solutions <info@litenova.solutions>",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "content:stage": "node scripts/stage-standards-docs.mjs && fumadocs-mdx",
    "dev": "pnpm run content:stage && next dev",
    "build": "pnpm run content:stage && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "next typegen && pnpm run content:stage && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm run content:stage && node scripts/validate-site.mjs",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm validate && pnpm build",
    "check:vinext": "vinext check",
    "dev:vinext": "pnpm run content:stage && vinext dev --port 3001",
    "build:vinext": "pnpm run content:stage && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview:vinext": "wrangler versions upload --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.6",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.11.5",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.53.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
