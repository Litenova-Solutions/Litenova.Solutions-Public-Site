{
  "name": "litenova-solutions-public-site",
  "description": "Public website and Engineering Standards documentation for Litenova Solutions, built with Next.js and Fumadocs.",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://www.litenova.solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Litenova-Solutions/Litenova.Solutions-Public-Site.git"
  },
  "bugs": {
    "url": "https://github.com/Litenova-Solutions/Litenova.Solutions-Public-Site/issues"
  },
  "author": "Litenova Solutions <info@litenova.solutions>",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "content:stage": "node scripts/stage-standards-docs.mjs && fumadocs-mdx",
    "dev": "pnpm run content:stage && next dev",
    "build": "pnpm run content:stage && next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "type-check": "next typegen && pnpm run content:stage && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "standards": "node scripts/validate-standards.mjs",
    "standards:ui": "node standards/tools/validate-ui.mjs",
    "validate": "pnpm run content:stage && node scripts/validate-site.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm standards && pnpm validate && pnpm build",
    "check:vinext": "vinext check",
    "dev:vinext": "pnpm run content:stage && vinext dev --port 3001",
    "build:vinext": "pnpm run content:stage && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview:vinext": "wrangler versions upload --config dist/server/wrangler.json",
    "standards:reference": "node standards/tools/validate-consumer.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-server-dom-webpack": "19.2.3",
    "tailwind-merge": "3.6.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
